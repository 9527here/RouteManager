    # ---- 高摩擦材质：场景原本**完全没有材质绑定**，PhysX 用默认值，实测
    # 桌面摩擦系数 ≈0.05（几乎无摩擦）→ 夹爪压住物体也夹不住，一抬就滑脱。
    def Material "friction_mat" (
        apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 1.0
        float physics:dynamicFriction = 1.0
        float physics:restitution = 0.0
    }

    def Xform "vla_table" (
        prepend references = @/home/jy/VLA/Collected_piper_table_clean_v2/piper_table_clean_v2.usd@</World/table>
    )
    {
        rel material:binding = </World/friction_mat>
        double3 xformOp:translate = (1.0, 0.0, 0.0)
        quatd xformOp:orient = (0.7071067811865476, 0.0, 0.0, 0.7071067811865475)
